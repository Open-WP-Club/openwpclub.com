---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { DISCORD_URL, GITHUB_ORG_URL } from '../lib/config';
const paths = [
  { title: 'Test and report', intro: 'You can help without writing code. A reproducible report gives maintainers a useful place to start.', steps: ['Choose a plugin and try it on a test site.', 'Write down the steps, expected result and what actually happened.', 'Include relevant plugin, WordPress, PHP and WooCommerce versions. Remove private data.', 'Check for an existing report, then open an issue in the plugin’s repository.'], href: '/plugins/', action: 'Find the plugin and its repository' },
  { title: 'Improve documentation', intro: 'A clear instruction or a working example can save the next person a lot of time.', steps: ['Find a confusing instruction or a missing example in a project README.', 'Check the project’s contributing guide and existing issues.', 'Edit the documentation and open a pull request explaining the change.'], href: `${GITHUB_ORG_URL}/.github/blob/main/CONTRIBUTING.md`, action: 'Read the contributing guide' },
  { title: 'Write code', intro: 'Pick a focused problem and share how you verified your solution.', steps: ['Browse open issues and read the discussion to see if someone is already working on one.', 'Ask a question on the issue if the scope is unclear.', 'Fork the repository, make and test your change, then open a pull request with the results.'], href: '/join/#open-issues', action: 'Find an open issue' },
  { title: 'Help with translations', intro: 'Help make a project easier to use in another language.', steps: ['Choose a plugin and check its repository for translation files or instructions.', 'Report missing or unclear strings if the project is not ready for translation.', 'Discuss the best way to submit a translation in the project’s issues.'], href: '/plugins/', action: 'Choose a project' },
  { title: 'Help the community', intro: 'Sharing what you know is a contribution too.', steps: ['Visit Discord and find a question you can help with.', 'Share a useful answer or help someone reproduce a problem.', 'For a confirmed bug, help put the details in the relevant GitHub issue.'], href: DISCORD_URL, action: 'Visit Discord' },
];
---
<BaseLayout title="Your First Contribution - Open WP Club" description="Make your first open-source contribution through testing, documentation, code, translations or community help.">
  <Breadcrumbs items={[{ label: 'How to Join', href: '/join/' }, { label: 'Your First Contribution' }]} />
  <section class="py-16 bg-gray-50 dark:bg-gray-950"><div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">A practical guide</p><h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white">Your first contribution can be small.</h1><p class="mt-5 max-w-3xl text-lg leading-relaxed text-gray-600 dark:text-gray-400">Choose a path that suits you. You don't need to join Discord or write code to get started. If you get stuck, ask a question in the relevant issue or in the community.</p>
    <div class="mt-10 grid gap-5 md:grid-cols-2">{paths.map((path) => <section class="flex flex-col rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 sm:p-8"><h2 class="text-2xl font-bold text-gray-900 dark:text-white">{path.title}</h2><p class="mt-3 text-sm leading-relaxed text-gray-600 dark:text-gray-400">{path.intro}</p><ol class="mt-5 flex-1 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-gray-600 dark:text-gray-400">{path.steps.map((step) => <li>{step}</li>)}</ol><a href={path.href} target={path.href.startsWith('https://') ? '_blank' : undefined} rel={path.href.startsWith('https://') ? 'noopener noreferrer' : undefined} class="mt-6 font-medium text-blue-600 dark:text-blue-400 hover:underline">{path.action} →</a></section>)}</div>
    <div class="mt-10 rounded-xl bg-blue-50 dark:bg-blue-950/30 border border-blue-100 dark:border-blue-900 p-6 sm:p-8"><h2 class="text-2xl font-bold text-gray-900 dark:text-white">Not sure what to pick?</h2><p class="mt-3 text-gray-600 dark:text-gray-400">Browse the current suggestions on the join page, or ask the community where your skills might help. Labels describe the kind of work; check the issue before starting.</p><a href="/join/#open-issues" class="mt-4 inline-block font-medium text-blue-600 dark:text-blue-400 hover:underline">See contribution opportunities →</a></div>
  </div></section>
</BaseLayout>
