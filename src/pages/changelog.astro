---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { GITHUB_ORG_URL } from '../lib/config';
import entries from '../data/changelog.json';
import releases from '../data/releases.json';
import DataFreshness from '../components/DataFreshness.astro';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';

async function renderReleaseNotes(markdown: string): Promise<string> {
  if (!markdown.trim()) return '';

  const html = await marked.parse(markdown, { gfm: true });
  return sanitizeHtml(html, {
    allowedTags: sanitizeHtml.defaults.allowedTags.concat(['h1', 'h2', 'img']),
    allowedAttributes: {
      ...sanitizeHtml.defaults.allowedAttributes,
      a: ['href', 'title', 'target', 'rel'],
      code: ['class'],
      img: ['src', 'alt', 'title', 'width', 'height'],
    },
    allowedSchemes: ['http', 'https', 'mailto'],
    transformTags: {
      a: (_tagName, attributes) => ({
        tagName: 'a',
        attribs: { ...attributes, target: '_blank', rel: 'noopener noreferrer' },
      }),
    },
  });
}

const recentReleases = await Promise.all(releases.slice(0, 30).map(async (release) => ({
  ...release,
  date: new Date(release.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
  notesHtml: await renderReleaseNotes(release.notes),
})));
---

<BaseLayout
  title="Changelog - Open WP Club"
  description="What's new at Open WP Club. Release notes, updates, and improvements to our website and plugins."
>
  <Breadcrumbs items={[{ label: 'Changelog' }]} />

  <!-- Hero -->
  <section class="pt-8 pb-16 bg-gradient-to-br from-blue-50 to-white dark:from-gray-900 dark:to-gray-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white leading-tight tracking-tight">
          What's <span class="text-blue-500">new</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-gray-600 dark:text-gray-400 leading-relaxed max-w-3xl mx-auto">
          Recent releases and improvements across every Open WP Club repository.
        </p>
        <p class="mt-3 text-sm text-gray-500 dark:text-gray-500"><DataFreshness /></p>
      </div>
    </div>
  </section>

  <!-- Two-column: Content + Sidebar -->
  <section class="py-12 bg-gray-50 dark:bg-gray-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-3 lg:gap-8">

        <!-- Main content -->
        <div class="lg:col-span-2 space-y-8">
          {recentReleases.length > 0 && (
            <section>
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Latest repository releases</h2>
              <div class="space-y-4">
                {recentReleases.map((release) => (
                  <article class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                      <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-900/40 text-blue-800 dark:text-blue-300">{release.repo}</span>
                      <span class="text-xs text-gray-500 dark:text-gray-400">{release.date}</span>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white text-balance">{release.name || `Release ${release.version}`}</h3>
                    {release.notesHtml && (
                      <div
                        class="release-notes prose prose-sm dark:prose-invert max-w-none mt-4 text-pretty prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-blue-500 prose-a:no-underline prose-a:break-words hover:prose-a:underline prose-code:before:content-none prose-code:after:content-none prose-hr:border-gray-200 dark:prose-hr:border-gray-700"
                        set:html={release.notesHtml}
                      />
                    )}
                    <a href={release.url} target="_blank" rel="noopener noreferrer" class="inline-flex mt-4 text-sm font-medium text-blue-500 hover:underline">View release v{release.version} on GitHub</a>
                  </article>
                ))}
              </div>
            </section>
          )}

          <h2 class="text-2xl font-bold text-gray-900 dark:text-white pt-4">Website milestones</h2>
          {entries.map((entry, index) => (
            <div class="relative">
              {index > 0 && (
                <div class="absolute -top-4 left-6 w-px h-4 bg-gray-200 dark:bg-gray-700"></div>
              )}
              <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8">
                <div class="flex items-center gap-3 mb-4">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 dark:bg-blue-900/40 text-blue-800 dark:text-blue-300">
                    {entry.date}
                  </span>
                </div>
                <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">{entry.title}</h2>
                <ul class="space-y-2">
                  {entry.items.map((item) => (
                    <li class="flex items-start gap-3 text-sm text-gray-600 dark:text-gray-400">
                      <svg class="size-5 shrink-0 text-green-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}

          <!-- CTA -->
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8 text-center">
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Want to see the full commit history?
            </p>
            <a
              href={`${GITHUB_ORG_URL}/www/commits/main`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 text-base font-medium rounded-lg text-white bg-blue-500 hover:bg-blue-600 shadow-sm transition-all duration-200"
            >
              <svg class="size-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd" />
              </svg>
              View on GitHub
            </a>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="mt-8 lg:mt-0">
          <div class="lg:sticky lg:top-24">
            <Sidebar />
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
