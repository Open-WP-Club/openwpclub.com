---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Contact from '../components/Contact.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { GITHUB_ORG_URL, DISCORD_URL, CONTACT_EMAIL } from '../lib/config';
import issueData from '../data/contribution-issues.json';
const issues = issueData as { updatedAt: string; items: Array<{ title: string; url: string; repo: string; labels: string[] }> };
const issueSearch = 'https://github.com/search?q=org%3AOpen-WP-Club+is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22%2Cdocumentation%2C%22help+wanted%22%2Ctesting&type=issues';

const allItems = await getCollection('plugins');
const pluginCount = allItems.filter((p) => p.data.category === 'plugin').length;

const ways = [
  {
    icon: 'lucide:code',
    title: 'Write code',
    description: 'Pick an open issue, fix a bug, or build a new feature. We use PHP for plugins, Astro + Tailwind for the website, and TypeScript for tooling.',
    action: 'Browse open issues',
    href: 'https://github.com/search?q=org%3AOpen-WP-Club+is%3Aissue+is%3Aopen&type=issues',
  },
  {
    icon: 'lucide:bug',
    title: 'Test & report bugs',
    description: 'Try our plugins on a test site and tell us what breaks. Detailed bug reports are just as valuable as code.',
    action: 'Learn how to report a bug',
    href: '/first-contribution/',
  },
  {
    icon: 'lucide:file-text',
    title: 'Write documentation',
    description: 'Improve README files, write tutorials, or translate existing docs. Good documentation makes plugins usable.',
    action: 'See contributing guide',
    href: `${GITHUB_ORG_URL}/.github/blob/main/CONTRIBUTING.md`,
  },
  {
    icon: 'lucide:message-circle',
    title: 'Help in the community',
    description: 'Answer questions on Discord, help newcomers with their first PR, or share our plugins with people who need them.',
    action: 'Join Discord',
    href: DISCORD_URL,
  },
  {
    icon: 'lucide:pen-line',
    title: 'Write for the blog',
    description: 'Got a WordPress story, tutorial, or opinion? We publish guest posts from the community - no editorial gatekeeping.',
    action: 'Pitch a post',
    href: `mailto:${CONTACT_EMAIL}?subject=Guest Post Proposal`,
  },
  {
    icon: 'lucide:heart',
    title: 'Sponsor',
    description: `We run entirely on contributions. Even small sponsorships help us maintain ${pluginCount}+ plugins and keep everything free for everyone.`,
    action: 'Contact about sponsoring',
    href: `mailto:${CONTACT_EMAIL}?subject=Sponsorship Inquiry`,
  },
  {
    icon: 'lucide:sparkles',
    title: 'Spare LLM credits',
    description: 'Got unused Claude, OpenAI, or other LLM credits sitting around? Point them at our open issues - there\'s always a backlog of bug fixes, docs, and small features waiting for someone to pick them up.',
    action: 'Browse open issues',
    href: 'https://github.com/search?q=org%3AOpen-WP-Club+is%3Aissue+is%3Aopen&type=issues',
  },
];

const steps = [
  { step: '1', title: 'Choose how to help', description: 'Pick a task below, test a plugin, improve documentation, or ask the community where help is needed.' },
  { step: '2', title: 'Find something to work on', description: 'Browse our GitHub issues labeled "good first issue" or pick any open bug/feature that interests you.' },
  { step: '3', title: 'Make your contribution', description: 'Share a useful bug report, help in the community, or open a pull request with your changes.' },
  { step: '4', title: 'You\'re in', description: 'Every contribution helps. There are no applications or waiting lists.' },
];
---

<BaseLayout
  title="How to Join - Open WP Club"
  description="Join Open WP Club - contribute code, report bugs, write docs, or help the community. No applications, no gatekeeping. Find a contribution that suits your skills."
>
  <Breadcrumbs items={[{ label: 'How to Join' }]} />

  <!-- Hero -->
  <section class="pt-8 pb-16 bg-gradient-to-br from-blue-50 to-white dark:from-gray-900 dark:to-gray-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white leading-tight tracking-tight">
          How to <span class="text-blue-500">join</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-gray-600 dark:text-gray-400 leading-relaxed max-w-3xl mx-auto">
          There's no application form. No interview. No approval committee. You join by contributing - code, docs, bug reports, community help, or anything else that makes our software better.
        </p>
      </div>
    </div>
  </section>

  <!-- Two-column: Content + Sidebar -->
  <section class="py-12 bg-gray-50 dark:bg-gray-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-3 lg:gap-8">

        <!-- Main content -->
        <div class="lg:col-span-2 space-y-10">

          <div id="open-issues" class="scroll-mt-24 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Help with an open issue</h2>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Pick a task that interests you. Check the discussion to see whether someone is already working on it.</p>
            {issues.items.length > 0 ? <ul class="mt-5 divide-y divide-gray-100 dark:divide-gray-700">{issues.items.map((issue) => <li class="py-3"><a href={issue.url} target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 dark:text-blue-400 hover:underline">{issue.title}</a><p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{issue.repo} · {issue.labels.join(' · ')}</p></li>)}</ul> : <p class="mt-4 text-sm text-gray-600 dark:text-gray-400">There are no suggested tasks available right now. Browse GitHub for current opportunities.</p>}
            {issues.updatedAt && <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">Suggestions refreshed {new Date(issues.updatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}.</p>}
            <a href={issueSearch} target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline">Browse contribution opportunities on GitHub →</a>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Your first contribution</h2>
            <ul class="mt-4 space-y-3 text-sm text-gray-600 dark:text-gray-400">
              <li><strong class="text-gray-900 dark:text-white">Test:</strong> Use a test site, reproduce a problem, and report the steps and WordPress, PHP and WooCommerce versions.</li>
              <li><strong class="text-gray-900 dark:text-white">Document:</strong> Clarify a README or add an example. Open a pull request with your change.</li>
              <li><strong class="text-gray-900 dark:text-white">Code:</strong> Check the issue discussion, ask questions if needed, and describe how you tested your pull request.</li>
              <li><strong class="text-gray-900 dark:text-white">Help others:</strong> Answer a question or help reproduce a report in Discord.</li>
            </ul>
            <a href="/first-contribution/" class="mt-5 inline-block font-medium text-blue-600 dark:text-blue-400 hover:underline">Read the first contribution guide →</a>
          </div>

          <!-- Ways to contribute -->
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white tracking-tight mb-2">Ways to contribute</h2>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-8">Pick whatever fits your skills and interests. Every contribution counts equally.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {ways.map((way) => (
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 flex flex-col">
                  <div class="flex items-center gap-3 mb-3">
                    <Icon name={way.icon} class="size-5 text-blue-500 shrink-0" />
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{way.title}</h3>
                  </div>
                  <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed flex-1">{way.description}</p>
                  <a
                    href={way.href}
                    target={way.href.startsWith('http') || way.href.startsWith('mailto') ? '_blank' : undefined}
                    rel={way.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="mt-4 inline-flex items-center text-sm font-medium text-blue-500 hover:text-blue-600 transition-colors"
                  >
                    {way.action}
                    <Icon name="lucide:arrow-right" class="ml-1 size-4" />
                  </a>
                </div>
              ))}
            </div>
          </div>

          <!-- Getting started steps -->
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white tracking-tight mb-6">Getting started</h2>
            <div class="space-y-6">
              {steps.map((item) => (
                <div class="flex gap-4">
                  <div class="flex-shrink-0 flex items-center justify-center size-10 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-500 dark:text-blue-400 font-bold text-lg">
                    {item.step}
                  </div>
                  <div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{item.title}</h3>
                    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{item.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- No gatekeeping -->
          <div class="bg-gradient-to-br from-green-50 via-white to-green-50 dark:from-green-950/30 dark:via-gray-800 dark:to-green-950/30 rounded-xl shadow-sm border border-green-200 dark:border-green-800/50 p-6 sm:p-8">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">No gatekeeping, ever</h2>
            <div class="space-y-4 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
              <p>
                We don't care about your experience level, your resume, or how many GitHub stars you have. If you want to help build free WordPress software, you're welcome here.
              </p>
              <p>
                First-time open source contributor? Great - we'll help you through your first PR. Seasoned maintainer? Even better - we could use your expertise. The only requirement is that you treat everyone with respect.
              </p>
            </div>
          </div>

          <!-- LLM friendly -->
          <div class="bg-gradient-to-br from-purple-50 via-white to-purple-50 dark:from-purple-950/30 dark:via-gray-800 dark:to-purple-950/30 rounded-xl shadow-sm border border-purple-200 dark:border-purple-800/50 p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-4">
              <Icon name="lucide:bot" class="size-6 text-purple-500 shrink-0" />
              <h2 class="text-xl font-bold text-gray-900 dark:text-white">We're LLM-friendly</h2>
            </div>
            <div class="space-y-4 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
              <p>
                We use AI tools ourselves, and we're happy to review PRs written with their help. An LLM is a tool, same as a compiler or a linter - we respect what it can do, but the person who submits the code owns it. Like with any tool, if it makes a mistake, that's on the author, not the tool.
              </p>
              <p>
                Open WP Club exists to help the WordPress community as a whole, and we'll use every tool we have access to if it helps us make the web a little better with every line of code - yours or an AI's.
              </p>
            </div>
          </div>

          <!-- Bring your plugin -->
          <div class="bg-gradient-to-br from-blue-50 via-white to-blue-50 dark:from-blue-950/30 dark:via-gray-800 dark:to-blue-950/30 rounded-xl shadow-sm border border-blue-200 dark:border-blue-800/50 p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-4">
              <Icon name="lucide:package-open" class="size-6 text-blue-500 shrink-0" />
              <h2 class="text-xl font-bold text-gray-900 dark:text-white">Bring your plugin here</h2>
            </div>
            <div class="space-y-4 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
              <p>
                Do you maintain a plugin that's currently hosted elsewhere - on your own GitHub, another organisation, or a platform that's shutting down? You can move it here.
              </p>
              <p>
                We accept plugins that meet a few simple requirements:
              </p>
              <ul class="list-none space-y-2 ml-1">
                {[
                  { icon: 'lucide:gift', text: 'Completely free — no premium tiers, no upsells, no freemium.' },
                  { icon: 'lucide:shield-check', text: 'GPL-compatible licence — the code must be open source.' },
                  { icon: 'lucide:star', text: 'Quality bar — functional, reasonably documented, and actively useful to WordPress users.' },
                  { icon: 'lucide:users', text: 'Willing to collaborate — you stay as maintainer and we help share the load.' },
                ].map((item) => (
                  <li class="flex items-start gap-2">
                    <Icon name={item.icon} class="size-4 text-blue-500 shrink-0 mt-0.5" />
                    <span>{item.text}</span>
                  </li>
                ))}
              </ul>
              <p>
                If that sounds like your plugin, reach out. We'll review it together and help with the migration - no red tape.
              </p>
            </div>
            <a
              href={`mailto:${CONTACT_EMAIL}?subject=Plugin Migration Inquiry`}
              class="mt-6 inline-flex items-center text-sm font-medium text-blue-500 hover:text-blue-600 transition-colors"
            >
              Get in touch about migrating
              <Icon name="lucide:arrow-right" class="ml-1 size-4" />
            </a>
          </div>

          <!-- Quick links -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <a
              href={DISCORD_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 px-6 py-4 text-base font-medium rounded-lg text-white bg-blue-500 hover:bg-blue-600 shadow-sm transition-all duration-200"
            >
              Join Discord
            </a>
            <a
              href={GITHUB_ORG_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 px-6 py-4 text-base font-medium rounded-lg text-blue-500 dark:text-blue-400 bg-white dark:bg-gray-900 border border-blue-500 hover:bg-blue-50 dark:hover:bg-gray-700 shadow-sm transition-all duration-200"
            >
              View GitHub
            </a>
            <a
              href={`${GITHUB_ORG_URL}/.github/blob/main/CONTRIBUTING.md`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 px-6 py-4 text-base font-medium rounded-lg text-blue-500 dark:text-blue-400 bg-white dark:bg-gray-900 border border-blue-500 hover:bg-blue-50 dark:hover:bg-gray-700 shadow-sm transition-all duration-200"
            >
              Contributing guide
            </a>
          </div>

        </div>

        <!-- Sidebar -->
        <div class="mt-8 lg:mt-0">
          <div class="lg:sticky lg:top-24">
            <Sidebar />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <Contact />
</BaseLayout>
