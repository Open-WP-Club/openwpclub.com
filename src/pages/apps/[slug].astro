---
import { Icon } from 'astro-icon/components';
import GitHubIcon from '../../components/icons/GitHubIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DataFreshness from '../../components/DataFreshness.astro';
import { getCollection } from 'astro:content';
import { readFileSync, existsSync } from 'node:fs';
import { formatFileSize, getChecksumAssets, getOperatingSystems, getPlatformDownloads } from '../../lib/app-releases';

export async function getStaticPaths() {
  const allItems = await getCollection('plugins');
  const apps = allItems.filter((p) => p.data.category === 'app');
  return apps.map((app) => ({
    params: { slug: app.id },
    props: { app },
  }));
}

const { app } = Astro.props;
const {
  name, description, version, githubUrl, stars, openIssues, lastPush, license, language, downloads,
  releaseAssets, releaseDownloads, releasePublishedAt, releaseUrl, platforms, icon, features, requirements, screenshots,
} = app.data;

const downloadsNum = releaseDownloads || (downloads ? parseInt(downloads, 10) : 0);
const platformDownloads = getPlatformDownloads(releaseAssets);
const checksumAssets = getChecksumAssets(releaseAssets);
const operatingSystems = getOperatingSystems(releaseAssets, platforms);

const readmePath = `src/data/readmes/${app.id}.html`;
let safeReadmeHtml = `<p>No README available. Visit the <a href="${githubUrl}">GitHub repository</a> for more information.</p>`;
if (existsSync(readmePath)) {
  try {
    safeReadmeHtml = readFileSync(readmePath, 'utf-8');
  } catch (e) {
    console.warn(`[apps/${app.id}] Failed to read README: ${(e as Error).message}`);
  }
}

interface RepoContributor { login: string; avatar: string; profileUrl: string; contributions: number; }
const repoContribPath = 'src/data/repo-contributors.json';
let appContributors: RepoContributor[] = [];
if (existsSync(repoContribPath)) {
  const allRepoContribs = JSON.parse(readFileSync(repoContribPath, 'utf-8'));
  appContributors = (allRepoContribs[app.id] || []).slice(0, 10);
}

const headingRegex = /<h([23])[^>]*(?:id="([^"]*)")?[^>]*>(.*?)<\/h[23]>/gi;
const toc: Array<{ level: number; id: string; text: string }> = [];
let match;
while ((match = headingRegex.exec(safeReadmeHtml)) !== null) {
  const level = parseInt(match[1]);
  const text = match[3].replace(/<[^>]*>/g, '').trim();
  const id = match[2] || text.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-');
  toc.push({ level, id, text });
}

let tocIndex = 0;
const processedHtml = safeReadmeHtml.replace(/<h([23])([^>]*)>/gi, (_m, level, attrs) => {
  if (tocIndex < toc.length) {
    const id = toc[tocIndex++].id;
    if (attrs.includes('id=')) return _m;
    return `<h${level}${attrs} id="${id}">`;
  }
  return _m;
});

function formatDate(d: string) {
  if (!d) return 'N/A';
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name, description,
  applicationCategory: platforms.some((platform) => ['windows', 'macos', 'linux'].includes(platform)) ? 'BusinessApplication' : 'MobileApplication',
  operatingSystem: operatingSystems.length > 0 ? operatingSystems.join(', ') : 'Any',
  ...(version && version !== 'N/A' && { softwareVersion: version }),
  ...(releasePublishedAt && { datePublished: releasePublishedAt }),
  ...(license && { license: `https://spdx.org/licenses/${license}` }),
  ...(icon && { image: icon }),
  ...(requirements.length > 0 && { softwareRequirements: requirements.join('; ') }),
  ...(platformDownloads.length > 0 && { downloadUrl: platformDownloads.map((download) => download.url) }),
  ...(screenshots.length > 0 && { screenshot: screenshots.map((screenshot) => screenshot.src) }),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  codeRepository: githubUrl,
};
---

<BaseLayout title={`${name} - Open WP Club`} description={description} ogType="website" ogImage={new URL(`/og/app/${app.id}.png`, Astro.site).toString()} jsonLd={softwareSchema}>
  <Breadcrumbs items={[{ label: 'Apps', href: '/apps/' }, { label: name }]} />

  <section class="bg-white dark:bg-gray-900 pb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
        <div class="flex-1 flex items-start gap-4">
          {icon && <img src={icon} alt="" width="64" height="64" class="size-14 sm:size-16 rounded-xl object-contain bg-white shadow-sm border border-gray-200 p-1" />}
          <div>
            <div class="flex items-center gap-3 flex-wrap">
              <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">{name}</h1>
              {version && version !== 'N/A' && (
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 dark:bg-blue-900/40 text-blue-800 dark:text-blue-300">
                  v{version}
                </span>
              )}
            </div>
            <p class="mt-3 text-lg text-gray-600 dark:text-gray-400 leading-relaxed max-w-3xl">{description}</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 border border-gray-900 text-sm font-medium rounded-lg text-white bg-gray-900 hover:bg-gray-800 transition-colors duration-200">
            <GitHubIcon class="size-4 mr-2" />
            GitHub
          </a>
          <a href={`${githubUrl}/issues/new`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-lg text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-200">
            <Icon name="lucide:circle-alert" class="size-4 mr-2" />
            Report Issue
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 bg-gray-50 dark:bg-gray-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-3 lg:gap-8">

        <div class="lg:col-span-2">
          {(features.length > 0 || requirements.length > 0) && (
            <div class="grid sm:grid-cols-2 gap-6 mb-8">
              {features.length > 0 && (
                <section class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
                  <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Highlights</h2>
                  <ul class="space-y-3">
                    {features.map((feature) => (
                      <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-400">
                        <Icon name="lucide:check" class="size-4 mt-0.5 shrink-0 text-green-500" />
                        {feature}
                      </li>
                    ))}
                  </ul>
                </section>
              )}
              {requirements.length > 0 && (
                <section class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
                  <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Requirements</h2>
                  <ul class="space-y-3">
                    {requirements.map((requirement) => (
                      <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-400">
                        <Icon name="lucide:circle-check" class="size-4 mt-0.5 shrink-0 text-blue-500" />
                        {requirement}
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </div>
          )}

          {screenshots.length > 0 && (
            <section class="mb-8 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8">
              <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Screenshots</h2>
              <div class="grid sm:grid-cols-2 gap-4">
                {screenshots.map((screenshot) => (
                  <figure>
                    <img src={screenshot.src} alt={screenshot.alt} loading="lazy" class="w-full rounded-lg border border-gray-200 dark:border-gray-700" />
                    {screenshot.caption && <figcaption class="mt-2 text-xs text-gray-500 dark:text-gray-400">{screenshot.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </section>
          )}

          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 sm:p-8 lg:p-10">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6 pb-4 border-b border-gray-200 dark:border-gray-700">README</h2>
            <div class="prose dark:prose-invert max-w-none" set:html={processedHtml} />
          </div>
        </div>

        <div class="mt-8 lg:mt-0 space-y-6">

          {toc.length > 2 && (
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-3">On this page</h3>
              <nav class="space-y-1">
                {toc.map((item) => (
                  <a href={`#${item.id}`} class={`block text-sm text-gray-600 dark:text-gray-400 hover:text-blue-500 dark:hover:text-blue-400 transition-colors truncate ${item.level === 3 ? 'pl-3' : ''}`}>
                    {item.text}
                  </a>
                ))}
              </nav>
            </div>
          )}

          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
            <h3 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-4">Details</h3>
            <dl class="space-y-3 text-sm">
              {version && version !== 'N/A' && (
                <div class="flex justify-between">
                  <dt class="text-gray-500 dark:text-gray-400">Version</dt>
                  <dd class="text-gray-900 dark:text-white font-medium">{version}</dd>
                </div>
              )}
              {downloadsNum > 0 && (
                <div class="flex justify-between">
                  <dt class="text-gray-500 dark:text-gray-400">
                    Release downloads
                    <DataFreshness class="block text-xs text-gray-400 dark:text-gray-500" />
                  </dt>
                  <dd class="text-gray-900 dark:text-white font-medium">{downloadsNum.toLocaleString()}</dd>
                </div>
              )}
              {lastPush && (
                <div class="flex justify-between">
                  <dt class="text-gray-500 dark:text-gray-400">Last updated</dt>
                  <dd class="text-gray-900 dark:text-white font-medium">{formatDate(lastPush)}</dd>
                </div>
              )}
              {license && (
                <div class="flex justify-between">
                  <dt class="text-gray-500 dark:text-gray-400">License</dt>
                  <dd class="text-gray-900 dark:text-white font-medium">{license}</dd>
                </div>
              )}
              {language && (
                <div class="flex justify-between">
                  <dt class="text-gray-500 dark:text-gray-400">Language</dt>
                  <dd class="inline-flex items-center gap-1.5 text-gray-900 dark:text-white font-medium">
                    <span class="size-2.5 rounded-full bg-blue-500"></span>
                    {language}
                  </dd>
                </div>
              )}
              <div class="flex justify-between">
                <dt class="text-gray-500 dark:text-gray-400">Stars</dt>
                <dd class="text-gray-900 dark:text-white font-medium">{stars}</dd>
              </div>
              {openIssues > 0 && (
                <div class="flex justify-between">
                  <dt class="text-gray-500 dark:text-gray-400">Open issues</dt>
                  <dd class="text-gray-900 dark:text-white font-medium">{openIssues}</dd>
                </div>
              )}
            </dl>
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
            <h3 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-3">Download</h3>
            {platformDownloads.length > 0 ? (
              <div class="space-y-2">
                {platformDownloads.map((dl) => (
                  <a href={dl.url} data-download-platform={dl.platform} class="download-option flex items-center justify-between gap-3 w-full px-4 py-3 text-sm font-medium rounded-lg text-white bg-blue-500 hover:bg-blue-600 transition-colors duration-200" title={dl.name}>
                    <span class="inline-flex items-center gap-2">
                      <Icon name={dl.icon} class="size-4" />
                      <span>{dl.label}</span>
                      <span class="recommended-badge hidden px-1.5 py-0.5 rounded bg-white/20 text-[10px] uppercase tracking-wide">Recommended</span>
                    </span>
                    {dl.size > 0 && <span class="text-xs font-normal text-blue-100">{formatFileSize(dl.size)}</span>}
                  </a>
                ))}
              </div>
            ) : (
              <p class="text-sm text-gray-500 dark:text-gray-400">No downloads available yet. Check back soon or follow the project on <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:underline">GitHub</a>.</p>
            )}
            {releaseUrl && <a href={releaseUrl} target="_blank" rel="noopener noreferrer" class="inline-flex mt-4 text-xs text-blue-500 hover:underline">View release notes on GitHub</a>}
            <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700 text-xs text-gray-500 dark:text-gray-400">
              {checksumAssets.length > 0 ? (
                <p>
                  Verify your download with {checksumAssets.map((asset, index) => (
                    <><a href={asset.url} class="text-blue-500 hover:underline">{asset.name}</a>{index < checksumAssets.length - 1 ? ', ' : ''}</>
                  ))}.
                </p>
              ) : (
                <p>Checksums are not currently published for this release. Download installers only from the GitHub links above.</p>
              )}
            </div>
          </div>

          {appContributors.length > 0 && (
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-3">Contributors</h3>
              <div class="flex flex-wrap gap-2">
                {appContributors.map((c) => (
                  <a href={c.profileUrl} target="_blank" rel="noopener noreferrer" title={`${c.login} (${c.contributions} commits)`} class="group relative">
                    <img src={`${c.avatar}&s=64`} alt={c.login} width="32" height="32" loading="lazy" class="size-8 rounded-full ring-2 ring-white dark:ring-gray-800 group-hover:ring-blue-500 transition-all" />
                  </a>
                ))}
              </div>
              <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">{appContributors.length} contributor{appContributors.length !== 1 ? 's' : ''}</p>
            </div>
          )}

          <Sidebar />

        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const agent = navigator.userAgent.toLowerCase();
    const platform = /android/.test(agent)
      ? 'android'
      : /iphone|ipad|ipod/.test(agent)
        ? 'ios'
        : /windows/.test(agent)
          ? 'windows'
          : /macintosh|mac os/.test(agent)
            ? 'macos'
            : /linux/.test(agent)
              ? 'linux'
              : '';
    if (!platform) return;
    document.querySelectorAll<HTMLElement>(`[data-download-platform="${platform}"]`).forEach((option) => {
      option.classList.add('ring-2', 'ring-blue-300', 'dark:ring-blue-700');
      option.querySelector('.recommended-badge')?.classList.remove('hidden');
    });
  });
</script>
