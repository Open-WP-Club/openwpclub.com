---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const allItems = await getCollection('plugins');
const plugins = allItems
  .filter((p) => p.data.category === 'plugin' && p.data.stars > 0)
  .sort((a, b) => a.id.localeCompare(b.id));

if (plugins.length === 0) return;

// Deterministic monthly selection
const now = new Date();
const seed = now.getUTCFullYear() * 12 + now.getUTCMonth();
const plugin = plugins[seed % plugins.length];

const monthLabel = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const githubUrl = plugin.data.githubUrl || `https://github.com/Open-WP-Club/${plugin.id}`;
---

<div class="bg-gradient-to-br from-indigo-50 via-white to-purple-50 dark:from-indigo-950/20 dark:via-gray-800 dark:to-purple-950/20 rounded-xl shadow-sm border border-indigo-100 dark:border-indigo-900/50 p-5">
  <h3 class="text-xs font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-0.5">
    Plugin of the Month
  </h3>
  <p class="text-xs text-gray-400 dark:text-gray-500 mb-4">{monthLabel}</p>

  <a href={`/plugins/${plugin.id}/`} class="group block mb-3">
    <span class="text-sm font-semibold text-gray-900 dark:text-white group-hover:text-blue-500 dark:group-hover:text-blue-400 transition-colors">
      {plugin.data.name}
    </span>
    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-2 leading-relaxed">
      {plugin.data.description}
    </p>
  </a>

  <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-gray-400 mb-4">
    <span class="inline-flex items-center gap-1">
      <Icon name="lucide:star" class="size-3.5" />
      {plugin.data.stars}
    </span>
    {plugin.data.version && plugin.data.version !== 'N/A' && (
      <span class="px-1.5 py-0.5 rounded text-xs font-medium bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300">
        v{plugin.data.version}
      </span>
    )}
  </div>

  <div class="flex gap-2">
    <a
      href={`/plugins/${plugin.id}/`}
      class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg text-white bg-blue-500 hover:bg-blue-600 transition-colors"
    >
      View plugin
    </a>
    <a
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center px-3 py-1.5 text-xs font-medium rounded-lg text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 hover:border-gray-300 dark:hover:border-gray-500 transition-colors"
      aria-label="View on GitHub"
    >
      <Icon name="lucide:github" class="size-3.5" />
    </a>
  </div>
</div>
