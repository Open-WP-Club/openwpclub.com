---
import freshness from '../data/freshness.json';

interface Props {
  kind?: 'catalog' | 'traffic' | 'releases';
  class?: string;
}

const { kind = 'catalog', class: className = '' } = Astro.props;
const sourceDate = kind === 'traffic'
  ? freshness.trafficUpdatedAt
  : kind === 'releases'
    ? freshness.releasesUpdatedAt
    : freshness.catalogUpdatedAt;
const cadence = kind === 'releases'
  ? 'Updated weekly'
  : kind === 'traffic'
    ? 'Updated weekly'
    : 'Updated monthly';
const formattedDate = new Date(sourceDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<span class={className}>{cadence} · Data as of {formattedDate}</span>
