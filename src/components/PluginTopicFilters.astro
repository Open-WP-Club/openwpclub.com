---
interface Props {
  topics: Array<[string, number]>;
  mobile?: boolean;
}
const { topics, mobile = false } = Astro.props;
const label = (topic: string) => topic === 'woocommerce' ? 'WooCommerce' : topic.split('-').map((word) => word[0].toUpperCase() + word.slice(1)).join(' ');
---
{topics.length > 0 && (
  <details open={!mobile} class:list={[mobile ? 'lg:hidden mb-4 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800' : 'mb-6']}>
    <summary class:list={['cursor-pointer', mobile ? 'px-3 py-2 text-sm font-semibold text-gray-700 dark:text-gray-200' : 'text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-2']}>Filter by tag <span class="topic-selection-count text-xs font-normal normal-case tracking-normal text-gray-500"></span></summary>
    <div class:list={[mobile ? 'px-3 pb-3' : 'px-3']}>
      <p class="mb-3 text-xs text-gray-500 dark:text-gray-400">Show plugins matching any selected tag.</p>
      <fieldset class="space-y-3">
        <legend class="sr-only">Plugin tags</legend>
        {topics.map(([topic, count]) => (
          <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 cursor-pointer">
            <input type="checkbox" class="plugin-topic size-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" value={topic} />
            <span class="min-w-0 flex-1">{label(topic)}</span>
            <span class="text-xs text-gray-400">{count}</span>
          </label>
        ))}
      </fieldset>
      <button type="button" class="clear-topics mt-3 text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline hidden">Clear tags</button>
    </div>
  </details>
)}
