{
  "name": "open-wp-club-website",
  "version": "2.0.0",
  "type": "module",
  "description": "A community website for WordPress open source enthusiasts",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "fetch-data": "tsx scripts/fetch-data.ts",
    "refresh": "tsx scripts/fetch-data.ts && astro build && pagefind --site dist"
  },
  "keywords": [
    "wordpress",
    "open-source",
    "community",
    "plugins",
    "astro"
  ],
  "author": "Open WP Club",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-WP-Club/www.git"
  },
  "homepage": "https://openwpclub.com",
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@iconify-json/lucide": "^1.2.121",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "astro-icon": "^1.1.5",
    "marked": "^18.0.9",
    "sanitize-html": "^2.17.6",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/sanitize-html": "^2.16.1",
    "pagefind": "^1.5.2",
    "tsx": "^4.23.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
